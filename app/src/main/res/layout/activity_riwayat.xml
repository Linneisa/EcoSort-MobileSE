<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07140E"
    android:orientation="vertical">

    <!-- ========================================================================= -->
    <!-- BAGIAN ATAS: Sekarang sudah ditambahkan Tombol Back di samping judul -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <!-- 👇 Tombol Back Manual menggunakan ic_menu_revert -->
        <ImageView
            android:id="@+id/btnBackHistory"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#E2E8F0" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Riwayat Transaksi"
            android:textColor="#E2E8F0"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/btnFilterSemua"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tab_active"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Semua"
            android:textColor="#050F0B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnFilterMasuk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tab_inactive"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Pemasukan"
            android:textColor="#475569"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnFilterKeluar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tab_inactive"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Pengeluaran"
            android:textColor="#475569"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Menggunakan ID asli bawaan kamu: rvRiwayat -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRiwayat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="20dp" />

</LinearLayout>