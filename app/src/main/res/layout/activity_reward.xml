<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.github.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#07140E"
    android:fitsSystemWindows="true"> <RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="16dp">

    <ImageView
        android:id="@+id/btnBackReward"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentStart="true"
        android:layout_alignTop="@id/txtJudulReward"
        android:layout_alignBottom="@id/txtJudulReward"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="#E2E8F0" />

    <TextView
        android:id="@+id/txtJudulReward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/btnBackReward"
        android:layout_toStartOf="@id/btnProfilTop" android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:text="Tukar Poin Eco"
        android:textColor="#E2E8F0"
        android:textSize="24sp"
        android:textStyle="bold" />

    <androidx.cardview.widget.CardView
        android:id="@+id/btnProfilTop"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_alignParentEnd="true"       android:layout_centerVertical="true"       android:clickable="true"                   android:focusable="true"                   android:foreground="?attr/selectableItemBackground" app:cardCornerRadius="19dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/imgProfilHeader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@android:drawable/sym_def_app_icon" />
    </androidx.cardview.widget.CardView>

</RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReward"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        tools:listitem="@layout/item_reward" />

</LinearLayout>