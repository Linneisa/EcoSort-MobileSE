<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#12241A"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Nama penjual + ID singkat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvNamaPenjual"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nama Penjual"
                android:textColor="#E2E8F0"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvShortId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tab_inactive"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="#ID"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Nama barang -->
        <TextView
            android:id="@+id/tvNamaBarang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="Nama Barang"
            android:textColor="#34D399"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Lokasi -->
        <TextView
            android:id="@+id/tvLokasiRongsok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="Lokasi: -"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- Tanggal -->
        <TextView
            android:id="@+id/tvTanggalRongsok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Diajukan: -"
            android:textColor="#475569"
            android:textSize="12sp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"
            android:background="#1E3A2B" />

        <!-- Label harga -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Harga Deal Negosiasi (Rp)"
            android:textColor="#34D399"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Input harga deal -->
        <EditText
            android:id="@+id/etHargaDeal"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_tab_inactive"
            android:hint="cth: 50000"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#475569"
            android:textSize="14sp" />

        <!-- Tombol konfirmasi -->
        <Button
            android:id="@+id/btnKonfirmasiRongsok"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:backgroundTint="#34D399"
            android:text="Konfirmasi Selesai"
            android:textColor="#050F0B"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
