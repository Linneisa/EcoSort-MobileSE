<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#12241A"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Baris utama: ikon | judul+tanggal | poin -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgIkonRiwayat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_tab_inactive"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="#64748B" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtJudulRiwayat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Setor Botol Plastik"
                    android:textColor="#E2E8F0"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtTanggalRiwayat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="28 Mei 2026 • 14:30"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtPoinRiwayat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+500 pts"
                android:textColor="#10B981"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Tombol aksi — hanya tampil untuk transaksi berstatus "menunggu" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBatalkan"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="16dp"
                android:text="Batalkan"
                android:textColor="#EF4444"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="#2D1A1A"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnLihatKode"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="16dp"
                android:text="Lihat Kode QR"
                android:textColor="#34D399"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="#1A3328"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
